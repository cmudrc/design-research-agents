{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-research-agents.dev/schemas/v1/tool_result.schema.json",
  "title": "ToolResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_name",
    "output",
    "success"
  ],
  "properties": {
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "object"
    },
    "success": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}
