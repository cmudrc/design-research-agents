{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-research-agents.dev/schemas/v1/tool_spec.schema.json",
  "title": "ToolSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "input_schema",
    "output_schema",
    "permissions",
    "cost_hints"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_cost_estimate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_ms_estimate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "usd_cost_estimate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
