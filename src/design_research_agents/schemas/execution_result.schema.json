{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-research-agents.dev/schemas/execution_result.schema.json",
  "title": "ExecutionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output",
    "success",
    "tool_results"
  ],
  "properties": {
    "output": {
      "type": "object"
    },
    "success": {
      "type": "boolean"
    },
    "tool_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "model_response": {
      "type": [
        "object",
        "null"
      ]
    },
    "step_results": {
      "type": "object"
    },
    "execution_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
