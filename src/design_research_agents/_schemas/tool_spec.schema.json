{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-research-agents.dev/schemas/tool_spec.schema.json",
  "title": "ToolSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "input_schema",
    "output_schema",
    "metadata",
    "permissions",
    "cost_hints"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "side_effects",
        "timeout_s",
        "max_output_bytes",
        "risky",
        "server_id"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "core",
            "mcp",
            "script",
            "custom"
          ]
        },
        "side_effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filesystem_read",
            "filesystem_write",
            "network",
            "commands"
          ],
          "properties": {
            "filesystem_read": {
              "type": "boolean"
            },
            "filesystem_write": {
              "type": "boolean"
            },
            "network": {
              "type": "boolean"
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "risky": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "server_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_cost_estimate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_ms_estimate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "usd_cost_estimate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
