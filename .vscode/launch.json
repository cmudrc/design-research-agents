{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VS Code: Hello World Example",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/agents/vscode_hello_world.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Setup Project",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    }
  ]
}
